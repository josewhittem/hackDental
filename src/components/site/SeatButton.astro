---
// Botón de plazas (componente de Jose, en verdes de marca). Los textos cambian solos según el cupo:
// data-open (abierto), data-urg (quedan 3 o menos; {n} = plazas libres) y data-full (completo).
interface Props {
  href?: string;
  label?: string;
  urgLabel?: string;
  fullLabel?: string;
  /** versión blanca para fondos verde oscuro */
  inv?: boolean;
  /** sin la cuenta atrás en la fila de información */
  noTime?: boolean;
  id?: string;
  class?: string;
}
const {
  href = '#contacto',
  label = 'Solicita tu plaza',
  urgLabel = 'Solicita una de las {n} plazas',
  fullLabel = 'Entra en la lista de espera',
  inv = false,
  noTime = false,
  id,
  class: cls,
} = Astro.props;
const external = href.startsWith('http');
---
<a class:list={['pz', { inv, 'no-time': noTime }, cls]} href={href} id={id} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <span class="pz-btn"><svg aria-hidden="true"><use href="#i-wa"/></svg><span data-open={label} data-urg={urgLabel} data-full={fullLabel}>{label}</span><span class="arr" aria-hidden="true">→</span></span>
  <span class="pz-info"><span class="pz-live"></span><span class="pz-seats" aria-hidden="true"></span><span data-pz-left>Plazas libres</span><span class="pz-sep"></span><span class="pz-time">Cierra en <b data-pz-clock>—</b></span></span>
</a>
