---
// Sitio principal de HackDental. Diseño basado en la plantilla Nuvola Dental,
// con el copy, la paleta verde y los CTA de HackDental.
import SiteLayout from '../layouts/SiteLayout.astro';
import IconSprite from '../components/Site/IconSprite.astro';
import CtaButton from '../components/Site/CtaButton.astro';
import { Image } from 'astro:assets';
import founder from '../assets/Ebook/author.webp';

const img = (name: string) => `/site/${name}`;

const fanCards = [
  ['aligner.jpg', 'Campaña de ortodoncia'],
  ['patient-smile.jpg', 'Pacientes de estética'],
  ['kid.jpg', 'Primeras visitas'],
  ['friends.jpg', 'Reseñas en Google'],
  ['implant-model.jpg', 'Pacientes de implantes'],
  ['doctor-pink.jpg', 'Marca del doctor'],
  ['brushes.jpg', 'Higiene recurrente'],
  ['scan-tablet.jpg', 'Web que convierte'],
  ['clinic-room.jpg', 'Clínicas en España'],
];

// Ejemplos del tipo de anuncios que se trabajan para una clínica (no son resultados de clientes).
const adExamples = [
  ['aligner.jpg', 'Ortodoncia invisible', 'Anuncio para adultos que quieren alinear su sonrisa sin brackets.'],
  ['patient-smile.jpg', 'Blanqueamiento', 'Oferta de entrada que lleva a una primera visita, no a un descuento.'],
  ['kid.jpg', 'Odontopediatría', 'Campaña para familias de la zona: la puerta a pacientes de por vida.'],
  ['friends.jpg', 'Carillas', 'Casos de estética que venden calidad en lugar de precio.'],
  ['implant-model.jpg', 'Implantes', 'Embudo para el tratamiento de mayor valor de tu clínica.'],
  ['doctor-pink.jpg', 'Marca personal', 'El doctor como cara de la clínica: confianza antes de la cita.'],
  ['brushes.jpg', 'Revisiones', 'Recordatorios que reactivan a los pacientes que ya tienes.'],
];

const services = [
  ['g-1', 'i-search', 'Auditoría de marketing', 'Dónde estás perdiendo pacientes hoy y qué arreglar primero.'],
  ['g-2', 'i-pin', 'Google Business', 'Ficha optimizada para aparecer cuando buscan dentista en tu zona.'],
  ['g-3', 'i-target', 'Meta Ads', 'Anuncios en Facebook e Instagram que filtran al paciente correcto.'],
  ['g-4', 'i-globe', 'Google Ads', 'Presencia en las búsquedas de pacientes con intención real.'],
  ['g-5', 'i-layers', 'Web para clínicas', 'Una web pensada para convertir visitas en citas, no para decorar.'],
  ['g-6', 'i-implant', 'Embudos de implantes', 'Captación del tratamiento que más rentabilidad deja.'],
  ['g-1', 'i-smile', 'Ortodoncia invisible', 'Campañas para un tratamiento largo y de alto valor.'],
  ['g-2', 'i-star', 'Reseñas', 'Un sistema para que tus pacientes contentos hablen por ti.'],
  ['g-3', 'i-chat', 'Seguimiento por WhatsApp', 'Que ningún lead se enfríe antes de agendar.'],
  ['g-4', 'i-spark', 'Contenido para redes', 'Mensajes con estrategia, no publicaciones genéricas.'],
  ['g-5', 'i-trend', 'Métricas y rentabilidad', 'Cuánto cuesta cada paciente y cuánto deja.'],
  ['g-6', 'i-check', 'Plan de crecimiento', 'Qué priorizar este 2026 para crecer en serio.'],
];

// Frases típicas que aparecen en las auditorías (no son testimonios de clientes).
const phrases = [
  ['Clínica con 2 sillas', 'Mis tratamientos son buenos, mi equipo es bueno… pero los pacientes nuevos no llegan.', 'aligner.jpg', 'tall'],
  ['Clínica con 3 sillas', 'Probé con una agencia y solo me hablaban de likes. Yo necesito pacientes en la silla.', '', ''],
  ['Dueña de clínica', 'Quiero abrir mi segunda clínica, pero la primera apenas es rentable.', '', ''],
  ['Clínica en Madrid', 'Facturo 10.000 € al mes y sé que una clínica como la mía debería estar en 30.000 €.', 'patient-smile.jpg', ''],
  ['Odontólogo y gerente', 'No tengo tiempo de aprender marketing. Necesito que alguien me diga qué hacer.', '', ''],
  ['Clínica familiar', 'La franquicia de al lado anuncia precios que yo no puedo ni quiero igualar.', '', ''],
  ['Clínica con 1 silla', 'Me llegan contactos por WhatsApp, pero se pierden antes de agendar.', 'clinic-room.jpg', ''],
  ['Clínica en Valencia', 'Me llaman pidiendo precio, no tratamiento. Quiero mejores pacientes.', '', ''],
  ['Clínica con 5 sillas', 'Invertimos en publicidad y no sabemos qué funciona y qué no.', '', ''],
  ['Ortodoncista', 'Mi web es bonita, pero nadie pide cita desde ella.', 'scan-tablet.jpg', ''],
  ['Clínica en Sevilla', 'Tenemos buenas reseñas, pero no aparecemos cuando buscan dentista en la zona.', '', ''],
  ['Implantólogo', 'Hago implantes de calidad y la gente llega preguntando por el más barato.', 'implant-model.jpg', ''],
];

const ribbons = [
  ['Ubicada en', 'España'], ['Factura más de', '10.000 € / mes'], ['Busca crecer', 'En 2026'],
  ['Ya atiende', 'Pacientes'], ['Quiere', 'Mejores tratamientos'], ['No busca', 'Solo descuentos'],
];

const faqs = [
  ['¿Qué es HackDental?', '<p>HackDental es marketing dental hecho por especialistas, no por una agencia genérica. Trabajas directamente con Jose Whittembury, su fundador, para diagnosticar por qué tu clínica no está creciendo y qué está bloqueando tus ventas hoy.</p>'],
  ['¿Para qué tipo de consultorio son los servicios de HackDental?', '<p>Para consultorios y clínicas dentales que ya atienden pacientes y quieren más pacientes, mejores tratamientos y menos desorden en su marketing. No trabajamos con clínicas que solo buscan descuentos, sino con quienes quieren crecer en serio y posicionarse mejor en su zona.</p>'],
  ['Me interesa la auditoría gratuita, ¿cómo aplico?', '<p>Solo debes llenar el formulario con los datos de tu clínica. Revisamos cada solicitud y, si vemos que podemos ayudarte, te contactamos para agendar la auditoría. Es un proceso simple y rápido.</p>'],
  ['¿Qué incluye la auditoría gratuita?', '<p>Analizamos:</p><ul><li>Tu web y si convierte visitas en citas</li><li>Tu captación de pacientes online</li><li>Tus anuncios y tu presencia en Google</li><li>Dónde estás perdiendo oportunidades</li></ul><p>Te mostramos qué mejorar, qué priorizar y qué acciones tomar para atraer mejores pacientes, aunque no trabajes con nosotros.</p>'],
  ['¿Es una llamada comercial?', '<p>No. Es un análisis estratégico de tu marketing y tu captación. Sin compromiso de compra y 100 % personalizado.</p>'],
  ['¿Trabajáis con clínicas fuera de España?', '<p>Por ahora la auditoría solo aplica si tu consultorio está en España.</p>'],
  ['¿Cuánto tardáis en responder?', '<p>Respondemos en menos de 24 horas. Si lo prefieres, también puedes aplicar por WhatsApp.</p>'],
];

const ctaItems = ['Gratis', 'Reunión 1:1', 'Respuesta en 24 h'];
const whatsapp = 'https://wa.me/51903300422?text=Hola,%20me%20interesa%20la%20auditor%C3%ADa%20de%20marketing%20dental';
---

<SiteLayout>
<IconSprite />

<!-- ===== Navegación ===== -->
<header class="nav is-top" id="nav">
  <div class="nav-inner">
    <a class="glass-pill nav-logo" href="#top" aria-label="HackDental, inicio">
      <svg class="logo-mark" style="color:#008060"><use href="#logo"/></svg>
      <span class="logo-word">Hack<b>Dental</b></span>
    </a>
    <nav class="glass-pill nav-center" aria-label="Principal">
      <a href="#metodo">Método</a>
      <a href="#servicios">Servicios</a>
      <a href="#como-funciona">Cómo aplicar</a>
      <a href="#faq">Preguntas</a>
    </nav>
    <CtaButton size="sm" text="Aplicar" />
  </div>
</header>

<main class="book" id="top">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <span class="orbit orbit-1" aria-hidden="true"></span>
    <span class="orbit orbit-2" aria-hidden="true"></span>
    <span class="orbit orbit-3" aria-hidden="true"></span>
    <span class="orbit orbit-4" aria-hidden="true"></span>

    <div class="hero-head container">
      <div class="fan" id="fan" aria-hidden="true">
        {fanCards.map(([file, label]) => (
          <div class="fan-card"><img src={img(file)} alt=""><span>{label}</span></div>
        ))}
      </div>
      <span class="trust-pill">
        <span class="avatars">
          <img src={img('doctor-phone.jpg')} alt="">
          <img src={img('doctor-teal.jpg')} alt="">
          <img src={img('doctor-pink.jpg')} alt="">
        </span>
        <span>Trabaja <b>1:1</b> con el fundador de <b>HackDental</b></span>
      </span>

      <p class="hero-eyebrow"><svg class="icon"><use href="#i-alert"/></svg> Solo para dueños de clínicas dentales</p>
      <h1 class="t-hero">Convierte tu clínica en la <span class="grad-text">nº1 de tu zona</span></h1>
      <p class="hero-sub t-body">Recibe una auditoría de marketing gratuita y descubre qué está bloqueando la llegada de pacientes nuevos a tu clínica.</p>

      <div class="hero-cta">
        <CtaButton size="lg" founder bounce items={ctaItems} />
        <p class="hero-note">Sin compromiso de compra. Análisis 100 % personalizado.</p>
      </div>

      <svg class="mascot hero-mascot" aria-hidden="true"><use href="#mascot"/></svg>
    </div>

    <!-- Pestañas: qué revisa la auditoría -->
    <div class="product-wrap">
    <svg class="mascot hero-mascot-m" aria-hidden="true"><use href="#mascot"/></svg>
    <div class="tabs" role="tablist" aria-label="Qué revisamos en tu auditoría">
      <button class="tab" role="tab" aria-selected="true" data-tab="captacion"><span class="tab-ico is-blue"><svg class="icon"><use href="#i-layers"/></svg></span><span class="tab-label">Captación</span></button>
      <button class="tab" role="tab" aria-selected="false" data-tab="web"><span class="tab-ico is-pink"><svg class="icon"><use href="#i-globe"/></svg></span><span class="tab-label">Web</span></button>
      <button class="tab" role="tab" aria-selected="false" data-tab="anuncios"><span class="tab-ico is-orange"><svg class="icon"><use href="#i-target"/></svg></span><span class="tab-label">Anuncios</span></button>
      <button class="tab" role="tab" aria-selected="false" data-tab="rentabilidad"><span class="tab-ico is-purple"><svg class="icon"><use href="#i-euro"/></svg></span><span class="tab-label">Rentabilidad</span></button>
    </div>

    <div class="rail">
      <div class="product soft-card">
        <!-- Panel: Captación (tablero de la auditoría) -->
        <div class="product-panel is-active" data-panel="captacion" role="tabpanel">
          <div class="panel-head"><span class="tab-ico is-blue"><svg class="icon"><use href="#i-layers"/></svg></span><b>Captación</b></div>
          <div class="app">
            <aside class="app-side" aria-hidden="true">
              <div class="app-brand"><svg class="logo-mark" style="color:#008060"><use href="#logo"/></svg> Tu auditoría</div>
              <a><svg class="icon"><use href="#i-home"/></svg> Resumen</a>
              <a class="is-active"><svg class="icon"><use href="#i-layers"/></svg> Captación</a>
              <a><svg class="icon"><use href="#i-globe"/></svg> Web</a>
              <a><svg class="icon"><use href="#i-target"/></svg> Anuncios</a>
              <a><svg class="icon"><use href="#i-star"/></svg> Reseñas</a>
              <a><svg class="icon"><use href="#i-chat"/></svg> WhatsApp</a>
              <div class="app-foot"><svg class="icon" style="width:12px;height:12px"><use href="#i-lock"/></svg> Tus datos, protegidos</div>
            </aside>
            <div class="app-main">
              <div class="app-top">
                <h3>Diagnóstico de tu clínica</h3>
                <span class="t-mini">Preparado por <span class="avatars"><img src={img('doctor-phone.jpg')} alt=""></span> Jose Whittembury</span>
              </div>
              <div class="kanban" aria-label="Hallazgos de la auditoría">
                <div class="kcol">
                  <div class="kcol-head"><i style="background:#c3cdc8"></i> Por revisar</div>
                  <div class="kcard"><b>Ficha de Google Business</b><small>Fotos, categorías y reseñas sin trabajar</small><div class="tags"><span class="ktag is-blue">Google</span><span class="ktag">Local</span></div></div>
                  <div class="kcard"><b>Mensaje de la web</b><small>Habla de la clínica, no del paciente</small><div class="tags"><span class="ktag is-pink">Web</span></div></div>
                  <div class="kcard"><b>Precio por delante</b><small>Vendes precio en lugar de calidad</small><div class="tags"><span class="ktag">Mensaje</span></div></div>
                </div>
                <div class="kcol">
                  <div class="kcol-head"><i style="background:#8cbf2f"></i> Prioridad</div>
                  <div class="kcard"><b>Campaña de implantes</b><small>Tu tratamiento de mayor valor sin captación</small><div class="tags"><span class="ktag is-blue">Implantes</span><span class="ktag is-orange">Meta Ads</span></div></div>
                  <div class="kcard"><b>Seguimiento de leads</b><small>Los contactos se enfrían antes de agendar</small><div class="tags"><span class="ktag is-green">WhatsApp</span></div></div>
                  <div class="kcard"><b>Formulario de cita</b><small>Demasiados pasos para pedir una visita</small><div class="tags"><span class="ktag is-pink">Web</span></div></div>
                </div>
                <div class="kcol">
                  <div class="kcol-head"><i style="background:#12925f"></i> A tu favor</div>
                  <div class="kcard"><b>Tratamientos de calidad</b><small>Lo difícil ya lo tienes</small><div class="tags"><span class="ktag is-purple">Clínica</span></div></div>
                  <div class="kcard"><b>Equipo con experiencia</b><small>Una historia que contar en anuncios</small><div class="tags"><span class="ktag is-purple">Marca</span></div></div>
                  <div class="kcard"><b>Pacientes satisfechos</b><small>Reseñas listas para pedir</small><div class="tags"><span class="ktag is-green">Reseñas</span></div></div>
                </div>
                <div class="kcol">
                  <div class="kcol-head"><i style="background:#008060"></i> Oportunidad</div>
                  <div class="kcard is-failed"><b>Publicidad genérica</b><small>Inversión sin estrategia ni medición</small><div class="tags"><span class="ktag">Anuncios</span></div></div>
                  <div class="kcard"><b>Plan para 2026</b><small>Qué hacer primero para crecer</small><div class="tags"><span class="ktag is-purple">Estrategia</span></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Web -->
        <div class="product-panel" data-panel="web" role="tabpanel">
          <div class="panel-head"><span class="tab-ico is-pink"><svg class="icon"><use href="#i-globe"/></svg></span><b>Web</b></div>
          <div class="panel-split">
            <div class="panel-copy">
              <h3>Una web que convierte visitas en citas, no solo bonita.</h3>
              <div class="lines">
                <div class="line-card"><span class="num" style="background:#008060">01</span><div><b>Mensaje centrado en el paciente</b><small>Qué gana, no cuántos años tiene la clínica</small></div></div>
                <div class="line-card"><span class="num" style="background:#00a37a">02</span><div><b>Páginas por tratamiento</b><small>Implantes, ortodoncia y estética con su propio camino</small></div></div>
                <div class="line-card"><span class="num" style="background:#0e8f7e">03</span><div><b>Pedir cita en dos toques</b><small>Formulario corto y WhatsApp siempre a mano</small></div></div>
              </div>
            </div>
            <div class="panel-photo">
              <img src={img('scan-tablet.jpg')} alt="Odontólogo mostrando información a un paciente en una tablet">
              <span class="float-chip" style="left:24px;top:24px"><span class="dot" style="background:#008060"><svg class="icon"><use href="#i-globe"/></svg></span>Visita → cita</span>
              <span class="float-chip" style="right:24px;bottom:24px"><span class="dot" style="background:#0e8f7e"><svg class="icon"><use href="#i-cal"/></svg></span>Nueva primera visita</span>
            </div>
          </div>
        </div>

        <!-- Panel: Anuncios -->
        <div class="product-panel" data-panel="anuncios" role="tabpanel">
          <div class="panel-head"><span class="tab-ico is-orange"><svg class="icon"><use href="#i-target"/></svg></span><b>Anuncios</b></div>
          <div class="panel-split">
            <div class="panel-copy">
              <h3>Anuncios que atraen al paciente correcto, no al que busca el más barato.</h3>
              <div class="lines">
                <div class="line-card"><span class="num" style="background:#4f9f2f">01</span><div><b>Meta y Google con estrategia</b><small>Cada euro con un objetivo y una métrica</small></div></div>
                <div class="line-card"><span class="num" style="background:#8cbf2f">02</span><div><b>Mensajes por tratamiento</b><small>Vender calidad en lugar de precio</small></div></div>
                <div class="line-card"><span class="num" style="background:#1f6f54">03</span><div><b>Leads que se siguen</b><small>Del clic al WhatsApp y a la silla</small></div></div>
              </div>
            </div>
            <div class="panel-photo">
              <img src={img('patient-smile.jpg')} alt="Paciente sonriendo en la consulta">
              <span class="float-chip" style="left:24px;top:24px"><span class="dot" style="background:#4f9f2f"><svg class="icon"><use href="#i-target"/></svg></span>Campaña de estética</span>
              <span class="float-chip" style="right:24px;bottom:24px"><span class="dot" style="background:#12925f"><svg class="icon"><use href="#i-check"/></svg></span>Paciente agendado</span>
            </div>
          </div>
        </div>

        <!-- Panel: Rentabilidad -->
        <div class="product-panel" data-panel="rentabilidad" role="tabpanel">
          <div class="panel-head"><span class="tab-ico is-purple"><svg class="icon"><use href="#i-euro"/></svg></span><b>Rentabilidad</b></div>
          <div class="panel-split">
            <div class="panel-copy">
              <h3>Más pacientes está bien. Más pacientes rentables, mejor.</h3>
              <div class="lines">
                <div class="line-card"><span class="num" style="background:#1f6f54">01</span><div><b>Tratamientos de alto valor</b><small>Implantes, ortodoncia y estética primero</small></div></div>
                <div class="line-card"><span class="num" style="background:#0e8f7e">02</span><div><b>Coste por paciente</b><small>Sabes cuánto te cuesta y cuánto te deja</small></div></div>
                <div class="line-card"><span class="num" style="background:#12925f">03</span><div><b>Base para tu segunda clínica</b><small>Primero llenar una, luego abrir la siguiente</small></div></div>
              </div>
            </div>
            <div class="panel-photo">
              <img src={img('doctor-teal.jpg')} alt="Dentista con uniforme en su clínica">
              <span class="float-chip" style="left:24px;top:24px"><span class="dot" style="background:#1f6f54"><svg class="icon"><use href="#i-trend"/></svg></span>Facturación en crecimiento</span>
              <span class="float-chip" style="right:24px;bottom:24px"><span class="dot" style="background:#008060"><svg class="icon"><use href="#i-pin"/></svg></span>Nº1 de tu zona</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>

    <!-- Texto que se revela con el scroll -->
    <div class="reveal-text container" data-wordreveal>
      <p>Tus tratamientos son buenos. Tu equipo es bueno. Pero eso no es suficiente en 2026.</p>
      <p>Hoy no gana la mejor clínica: gana la que tiene una estrategia de marketing rentable.</p>
      <p>HackDental la diseña contigo para traer <span class="inline-ico" style="background:#dcf0e9;color:#0e8f7e"><svg class="icon"><use href="#i-user"/></svg></span> más pacientes y <span class="inline-ico" style="background:#d6eee3;color:#008060"><svg class="icon"><use href="#i-implant"/></svg></span> mejores tratamientos a tu clínica.</p>
    </div>

    <!-- Cinta de ejemplos de anuncios -->
    <div class="belt" aria-label="Ejemplos de campañas para clínicas dentales">
      <div class="belt-track" id="belt">
        {[...adExamples, ...adExamples].map(([file, title, text], i) => (
          <article class="case" aria-hidden={i >= adExamples.length ? 'true' : undefined}>
            <div class="case-head"><span class="avatars"><span style="background:#008060"><svg class="icon" style="width:12px;height:12px;color:#fff"><use href="#logo"/></svg></span></span><div><b>tuclinica.dental</b><small>Publicidad · ejemplo</small></div><span class="more">···</span></div>
            <img src={img(file)} alt="" loading="lazy">
            <div class="case-foot">
              <div class="acts"><svg class="icon"><use href="#i-heart"/></svg><svg class="icon"><use href="#i-chat"/></svg><svg class="icon"><use href="#i-send"/></svg><svg class="icon save"><use href="#i-bookmark"/></svg></div>
              <b>Pide tu primera visita</b>
              <small><strong>{title}.</strong> {text}</small>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Contador -->
    <div class="counter rail" id="destacados">
      <div class="big-number" id="counter" data-count="30000" data-suffix=" €">30.000 €</div>
      <h2 class="sr-only">Lo que una clínica como la tuya debería facturar al mes.</h2>
      <div class="counter-card soft-card">
        <div class="badges" aria-hidden="true">
          <span class="badge"><b>1:1</b>fundador</span>
          <span class="badge"><b>24 h</b>respuesta</span>
          <span class="badge"><b>0 €</b>auditoría</span>
        </div>
        <div>
          <h2>Lo que una clínica como la tuya debería facturar al mes.</h2>
          <p>Si hoy facturas 10.000 €, el problema no son tus tratamientos: es que no sabes conseguir pacientes online.</p>
        </div>
        <CtaButton text="Quiero mi auditoría" />
      </div>
    </div>
  </section>

  <!-- ===== MÉTODO ===== -->
  <section class="elite rail" id="metodo">
    <div class="elite-grid">
      <h2 class="t-h1 glow-title reveal" data-text="Marketing dental hecho por expertos.
No por una agencia genérica.">Marketing dental hecho por expertos.<br><span class="l2">No por una agencia genérica.</span></h2>
      <div class="elite-copy reveal d-1">
        <p>El marketing genérico no funciona en clínicas dentales. Publicidad genérica, mensajes sin estrategia y vender precio en lugar de calidad: eso hace la mayoría.</p>
        <p>Mi trabajo es diagnosticar exactamente por qué tu clínica no está creciendo y qué está bloqueando tus ventas hoy.</p>
      </div>
      <div class="elite-stage reveal">
        <svg class="mascot mascot-big" aria-hidden="true"><use href="#mascot"/></svg>
        <svg class="icon spark" style="width:28px;height:28px;left:18%;top:22%"><use href="#i-spark"/></svg>
        <svg class="icon spark" style="width:18px;height:18px;right:20%;top:30%;color:#008060"><use href="#i-spark"/></svg>
        <svg class="icon spark" style="width:22px;height:22px;right:24%;bottom:18%;color:#8cbf2f"><use href="#i-spark"/></svg>
      </div>
      <div class="wishes">
        <div class="wish soft-card soft-card--16 is-blue reveal"><div><div class="label">Diagnóstico</div><h3>Auditoría de tu captación</h3></div><div class="mini mini-cal"><span>1</span><span>2</span><span>3</span><span class="on">4</span><span>5</span><span>6</span><span class="on">7</span><span>8</span><span>9</span><span class="on">10</span><span>11</span><span>12</span><span>13</span><span class="on">14</span><span>15</span></div></div>
        <div class="wish soft-card soft-card--16 is-pink reveal d-1"><div><div class="label">Plan</div><h3>Qué priorizar, sin humo</h3></div><div class="mini"><div class="mini-bars"><i></i><i></i><i></i><i></i></div><div class="mini-bars-label"><span>Hoy</span><span>Mes 1</span><span>Mes 3</span><span>2026</span></div></div></div>
